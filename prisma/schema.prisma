generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  draft
  active
  archived
}

enum PaymentState {
  not_created
  pending
  paid
  expired
  canceled
  failed
  denied
  refund_pending
  refunded
  partially_refunded
}

enum FulfillmentState {
  awaiting_payment
  awaiting_processing
  processing
  packed
  shipment_booked
  handover_pending
  handed_over
  completed
  cancel_requested
  cancelled
  return_requested
  return_in_transit
  returned
  finished
}

enum ReturnState {
  requested
  under_review
  rejected
  approved
  awaiting_handover
  in_transit
  received
  inspection_passed
  inspection_failed
  refund_pending
  refunded
  closed
  awaiting_approval
  waiting_waybill
  processing_return
  return_complete
  processing_refund
  cancelled
  finished
}

enum RefundState {
  pending
  processing
  completed
  failed
}

enum CancellationState {
  requested
  approved
  rejected
  provider_pending
  provider_failed
}

model Product {
  id             String           @id @default(cuid())
  slug           String           @unique @db.VarChar(180)
  name           String           @db.VarChar(180)
  description    String           @db.Text
  legacyCategory String?          @map("category") @db.VarChar(100)
  categoryId     String?
  hasVariants    Boolean          @default(false)
  option1Name    String?          @db.VarChar(80)
  option2Name    String?          @db.VarChar(80)
  seoTitle       String?          @db.VarChar(180)
  seoDescription String?          @db.VarChar(320)
  shopeeLink     String?          @db.VarChar(500)
  tiktokLink     String?          @db.VarChar(500)
  tokopediaLink  String?          @db.VarChar(500)
  rating         Float            @default(0.0)
  sold           Int              @default(0)
  status         ProductStatus    @default(draft)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants       ProductVariant[]
  images         ProductImage[]
  cartItems      CartItem[]

  @@index([categoryId, status])
  @@index([status, updatedAt])
}

model ProductCategory {
  id          String    @id @default(cuid())
  slug        String    @unique @db.VarChar(120)
  name        String    @unique @db.VarChar(100)
  description String?   @db.VarChar(255)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model ProductVariant {
  id                String           @id @default(cuid())
  productId         String
  sku               String           @unique @db.VarChar(80)
  barcode           String?          @unique @db.VarChar(80)
  name              String           @db.VarChar(180)
  option1Value      String?          @db.VarChar(80)
  option2Value      String?          @db.VarChar(80)
  color             String?          @db.VarChar(80)
  size              String?          @db.VarChar(40)
  price             BigInt
  compareAt         BigInt?
  weight            Int
  length            Int?
  width             Int?
  height            Int?
  insuranceValue    BigInt?
  lowStockThreshold Int              @default(5)
  position          Int              @default(0)
  active            Boolean          @default(true)
  imageKey          String?          @db.VarChar(500)
  product           Product          @relation(fields: [productId], references: [id])
  inventory         InventoryLevel[]
  cartItems         CartItem[]

  @@index([productId, active, position])
  @@index([productId, option1Value, option2Value])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  objectKey String  @db.VarChar(500)
  alt       String  @db.VarChar(255)
  position  Int     @default(0)
  primary   Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id])

  @@index([productId, position])
}

model Warehouse {
  id           String           @id @default(cuid())
  name         String           @db.VarChar(160)
  contactName  String           @db.VarChar(160)
  contactPhone String           @db.VarChar(40)
  address      String           @db.Text
  postalCode   String           @db.VarChar(10)
  areaId       String?          @db.VarChar(120)
  isDefault    Boolean          @default(false)
  inventory    InventoryLevel[]
  shipments    Shipment[]
}

model InventoryLevel {
  id          String         @id @default(cuid())
  variantId   String
  warehouseId String
  onHand      Int            @default(0)
  reserved    Int            @default(0)
  safetyStock Int            @default(0)
  version     Int            @default(0)
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])

  @@unique([variantId, warehouseId])
}

model InventoryMovement {
  id            String   @id @default(cuid())
  variantId     String
  warehouseId   String
  type          String   @db.VarChar(40)
  quantityDelta Int
  referenceType String?  @db.VarChar(40)
  referenceId   String?  @db.VarChar(120)
  reason        String?  @db.VarChar(255)
  actorId       String?  @db.VarChar(120)
  dedupeKey     String?  @unique @db.VarChar(220)
  createdAt     DateTime @default(now())

  @@index([variantId, createdAt])
  @@index([referenceType, referenceId])
}

model Order {
  id               String                @id @default(cuid())
  publicNumber     String                @unique @db.VarChar(40)
  userId           String?
  guestName        String                @db.VarChar(160)
  guestEmail       String                @db.VarChar(200)
  guestPhone       String                @db.VarChar(40)
  accessTokenHash  String                @db.VarChar(128)
  policyVersion    String                @default("2026-07") @db.VarChar(30)
  policyAcceptedAt DateTime              @default(now())
  currency         String                @default("IDR") @db.VarChar(3)
  subtotal         BigInt
  shippingFee      BigInt
  serviceFee       BigInt                @default(0)
  grandTotal       BigInt
  paymentState     PaymentState          @default(not_created)
  fulfillmentState FulfillmentState      @default(awaiting_payment)
  issueOrder       Boolean               @default(false)
  issueReason      String?               @db.VarChar(120)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  user             User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  addresses        OrderAddress[]
  payments         Payment[]
  quotes           ShippingQuote[]
  shipments        Shipment[]
  returns          ReturnRequest[]
  refunds          Refund[]
  cancellations    CancellationRequest[]

  @@index([paymentState, createdAt])
  @@index([fulfillmentState, createdAt])
  @@index([guestEmail, createdAt])
  @@index([issueOrder, fulfillmentState])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([userId, paymentState, createdAt])
  @@index([guestEmail, paymentState, createdAt])
}

model OrderItem {
  id              String       @id @default(cuid())
  orderId         String
  variantId       String?
  skuSnapshot     String       @db.VarChar(80)
  nameSnapshot    String       @db.VarChar(180)
  optionsSnapshot Json
  unitPrice       BigInt
  quantity        Int
  weight          Int
  length          Int?
  width           Int?
  height          Int?
  order           Order        @relation(fields: [orderId], references: [id])
  returnItems     ReturnItem[]

  @@index([orderId])
}

model OrderAddress {
  id           String   @id @default(cuid())
  orderId      String
  type         String   @db.VarChar(20)
  contactName  String   @db.VarChar(160)
  contactPhone String   @db.VarChar(40)
  contactEmail String?  @db.VarChar(200)
  address      String   @db.Text
  note         String?  @db.VarChar(255)
  postalCode   String   @db.VarChar(10)
  areaId       String?  @db.VarChar(120)
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  order        Order    @relation(fields: [orderId], references: [id])

  @@index([orderId, type])
}

model Payment {
  id                String         @id @default(cuid())
  orderId           String
  provider          String         @default("bstn") @db.VarChar(40)
  providerPaymentId String?        @unique @db.VarChar(120)
  projectPaymentRef String         @unique @db.VarChar(100)
  amount            BigInt
  payableAmount     BigInt?
  feeAmount         BigInt?
  status            PaymentState   @default(not_created)
  paymentPageUrl    String?        @db.Text
  expiresAt         DateTime?
  paidAt            DateTime?
  raw               Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  order             Order          @relation(fields: [orderId], references: [id])
  events            PaymentEvent[]
  refunds           Refund[]

  @@index([orderId, status])
}

model PaymentEvent {
  id              String   @id @default(cuid())
  paymentId       String
  providerEventId String   @unique @db.VarChar(160)
  status          String   @db.VarChar(50)
  payload         Json
  occurredAt      DateTime
  payment         Payment  @relation(fields: [paymentId], references: [id])
}

model ShippingQuote {
  id                String    @id @default(cuid())
  orderId           String
  courierCompany    String    @db.VarChar(40)
  courierType       String    @db.VarChar(60)
  courierName       String    @db.VarChar(100)
  price             BigInt
  etaText           String?   @db.VarChar(120)
  collectionMethods Json?
  request           Json
  response          Json
  selectedAt        DateTime?
  createdAt         DateTime  @default(now())
  order             Order     @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
}

model Shipment {
  id                 String                  @id @default(cuid())
  orderId            String
  warehouseId        String
  providerOrderId    String?                 @unique @db.VarChar(120)
  referenceId        String                  @unique @db.VarChar(120)
  trackingId         String?                 @unique @db.VarChar(120)
  waybillId          String?                 @db.VarChar(120)
  courierCompany     String                  @db.VarChar(40)
  courierType        String                  @db.VarChar(60)
  courierName        String?                 @db.VarChar(100)
  collectionMethod   String                  @db.VarChar(20)
  quotedPrice        BigInt
  actualPrice        BigInt?
  priceAdjustment    BigInt                  @default(0)
  status             String                  @default("confirmed") @db.VarChar(50)
  waybillUpdatedAt   DateTime?
  lastProviderSyncAt DateTime?
  raw                Json?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  order              Order                   @relation(fields: [orderId], references: [id])
  warehouse          Warehouse               @relation(fields: [warehouseId], references: [id])
  events             ShipmentTrackingEvent[]

  @@index([orderId, status])
  @@index([status, updatedAt])
}

model ShipmentTrackingEvent {
  id             String   @id @default(cuid())
  shipmentId     String
  providerStatus String   @db.VarChar(50)
  note           String?  @db.Text
  occurredAt     DateTime
  payloadHash    String   @db.VarChar(128)
  payload        Json
  shipment       Shipment @relation(fields: [shipmentId], references: [id])

  @@unique([shipmentId, payloadHash])
  @@index([shipmentId, occurredAt])
}

model ReturnRequest {
  id             String       @id @default(cuid())
  orderId        String
  publicNumber   String       @unique @db.VarChar(40)
  source         String       @default("buyer") @db.VarChar(20)
  cause          String?      @db.VarChar(80)
  reason         String       @db.VarChar(80)
  description    String       @db.Text
  evidence       Json?
  state          ReturnState  @default(requested)
  decisionReason String?      @db.Text
  refundAmount   BigInt?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  order          Order        @relation(fields: [orderId], references: [id])
  items          ReturnItem[]
  refunds        Refund[]

  @@index([state, createdAt])
}

model ReturnItem {
  id              String        @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int
  inspection      String?       @db.VarChar(40)
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id])
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
}

model CancellationRequest {
  id                String            @id @default(cuid())
  orderId           String
  reason            String            @db.Text
  state             CancellationState @default(requested)
  fulfillmentBefore FulfillmentState
  decisionReason    String?           @db.Text
  providerResult    Json?
  requestedAt       DateTime          @default(now())
  decidedAt         DateTime?
  decidedBy         String?           @db.VarChar(120)
  order             Order             @relation(fields: [orderId], references: [id])

  @@index([state, requestedAt])
  @@index([orderId, requestedAt])
}

model Refund {
  id              String         @id @default(cuid())
  orderId         String
  paymentId       String
  returnRequestId String?
  amount          BigInt
  status          RefundState    @default(pending)
  method          String?        @db.VarChar(80)
  reference       String?        @db.VarChar(160)
  proofObjectKey  String?        @db.VarChar(500)
  processedBy     String?        @db.VarChar(120)
  processedAt     DateTime?
  createdAt       DateTime       @default(now())
  order           Order          @relation(fields: [orderId], references: [id])
  payment         Payment        @relation(fields: [paymentId], references: [id])
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id])

  @@index([status, createdAt])
}

model WebhookInbox {
  id             String    @id @default(cuid())
  source         String    @db.VarChar(40)
  deliveryKey    String    @db.VarChar(180)
  signatureValid Boolean   @default(false)
  payloadHash    String    @db.VarChar(128)
  headers        Json?
  payload        Json
  status         String    @default("received") @db.VarChar(30)
  error          String?   @db.Text
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  @@unique([source, deliveryKey])
  @@index([status, receivedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorType  String   @db.VarChar(40)
  actorId    String?  @db.VarChar(120)
  action     String   @db.VarChar(120)
  entityType String   @db.VarChar(60)
  entityId   String   @db.VarChar(120)
  before     Json?
  after      Json?
  ipHash     String?  @db.VarChar(128)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique @db.VarChar(200)
  name             String             @db.VarChar(160)
  phone            String?            @db.VarChar(40)
  avatarUrl        String?            @db.VarChar(500)
  googleId         String             @unique @db.VarChar(120)
  currentSessionId String?            @db.VarChar(120)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  orders           Order[]
  addresses        UserAddress[]
  refundSetting    UserRefundSetting?
  cartItems        CartItem[]

  @@index([createdAt])
}

model UserAddress {
  id           String @id @default(cuid())
  userId       String
  label        String @db.VarChar(80)
  contactName  String @db.VarChar(160)
  contactPhone String @db.VarChar(40)
  contactEmail String @db.VarChar(200)
  address      String @db.Text
  postalCode   String @db.VarChar(10)
  areaId       String @db.VarChar(120)
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserRefundSetting {
  id               String  @id @default(cuid())
  userId           String  @unique
  type             String  @db.VarChar(20)
  bankName         String? @db.VarChar(100)
  bankOwnerName    String? @db.VarChar(160)
  bankNumber       String? @db.VarChar(80)
  ewalletName      String? @db.VarChar(100)
  ewalletOwnerName String? @db.VarChar(160)
  ewalletNumber    String? @db.VarChar(80)
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CartItem {
  id        String         @id @default(cuid())
  userId    String
  productId String
  variantId String
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@index([userId])
}
