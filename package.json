{
  "name": "amk-store",
  "version": "1.2.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "install": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint . --ignore-pattern .next",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "setup": "prisma generate && prisma db push && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "prisma": "^6.16.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "AMK Store"
}
