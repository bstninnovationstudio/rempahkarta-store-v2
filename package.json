{
  "name": "amk-store",
  "version": "1.3.5",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "install": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint . --ignore-pattern .next",
    "auth:hash-password": "node --import tsx scripts/hash-admin-password.mjs",
    "migrate:private-media": "node scripts/migrate-private-media.mjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:baseline:existing": "prisma migrate resolve --applied 0_baseline",
    "db:seed": "node prisma/seed.mjs",
    "db:reset-user": "node --import tsx scripts/reset-user.ts",
    "setup": "prisma generate && prisma migrate deploy",
    "setup:demo": "prisma generate && prisma db push && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "jose": "^6.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.468.0",
    "next": "16.2.12",
    "prisma": "6.19.3",
    "react": "19.2.6",
    "react-barcode": "^1.6.1",
    "react-dom": "19.2.6",
    "sharp": "0.35.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.19",
    "sharp": "0.35.0"
  },
  "type": "module",
  "displayName": "Rempahkarta Store"
}
