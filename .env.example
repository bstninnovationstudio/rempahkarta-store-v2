# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000
DEMO_MODE=false
# Hanya untuk fixture lokal tanpa data nyata. Jangan aktifkan pada preview/staging publik.
ALLOW_INSECURE_DEMO=false
# Opsional. Isi hanya bila reverse proxy menghapus header dari client dan menulis ulang IP tepercaya.
# Nilai: cf-connecting-ip, x-real-ip, atau x-forwarded-for. Tanpa nilai ini,
# limiter sengaja memakai satu bucket aman bersama ("unidentified").
# RATE_LIMIT_TRUSTED_IP_HEADER=cf-connecting-ip

# MySQL (satu-satunya database/runtime service)
DATABASE_URL=mysql://user:password@127.0.0.1:3306/amk_store

# Admin auth. Generate tanpa menaruh password di history:
# read -s ADMIN_PASSWORD; printf '%s' "$ADMIN_PASSWORD" | npm run auth:hash-password; unset ADMIN_PASSWORD
AUTH_SECRET=replace_me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_SCRYPT=replace-with-output-auth-hash-password
# Legacy SHA-256 hanya didukung pada development, bukan production.
# ADMIN_PASSWORD_HASH=replace-with-64-char-sha256-hash

# BSTN Dynamic QRIS
BSTN_BASE_URL=https://www.bstn-innovation-studio.web.id
BSTN_PROJECT_API_KEY=bstn_test_replace_me
BSTN_RETURN_SIGNATURE_SECRET=replace_me

# true = payment lokal untuk pengujian tanpa memanggil BSTN.
# PAYMENT_MOCK_AUTO_PAID=true langsung membuat status paid; false menampilkan tombol simulasi.
PAYMENT_MOCK=true
PAYMENT_MOCK_AUTO_PAID=false

# Cloudflare Turnstile. Untuk localhost gunakan test key resmi di README.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Biteship
BITESHIP_BASE_URL=https://api.biteship.com
BITESHIP_API_KEY=replace_me
BITESHIP_WEBHOOK_SHARED_SECRET=replace_me
ENABLED_COURIERS=jne,sicepat,anteraja,jnt
WAREHOUSE_AREA_ID=replace_with_biteship_area_id
WAREHOUSE_POSTAL_CODE=12110
WAREHOUSE_NAME=Gudang Utama REMPAHKARTA
WAREHOUSE_CONTACT_NAME=REMPAHKARTA
WAREHOUSE_CONTACT_PHONE=081200000000
WAREHOUSE_ADDRESS=Alamat lengkap gudang

# Google OAuth (untuk Login/Signup pelanggan)
# Dapatkan Client ID dari Google Cloud Console API Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace_with_google_client_id

# Customer JWT Secret (opsional, jika kosong menggunakan AUTH_SECRET)
CUSTOMER_JWT_SECRET=replace_me
